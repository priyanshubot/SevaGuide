# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Maps Embed API Key
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Server-side OpenRouter API Key (Set in Supabase Secrets or Serverless environment; NEVER use VITE_ prefix)
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional: OpenRouter Model ID (Defaults to google/gemma-4-31b-it:free)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

